# Your secret knock: 4 or more taps from: logo mark rankup cyberlogix omniarmor
# Make up your own. Never commit the real one.
MTRX_KNOCK=
# One-time code to approve the first device (at least 16 characters).
# Change it to a new code to get back in if every device is lost.
MTRX_SETUP_TOKEN=
# Where the database lives (keep it on a disk that survives restarts).
MTRX_DB_PATH=data/horizon.db
# Set to 1 when running behind a hosting proxy (Render, Fly, etc.).
MTRX_TRUST_PROXY=0
# Optional: the site's public address, used in QR codes: https://<your domain>.
MTRX_PUBLIC_URL=
# Optional: where business enquiries go, shown as an email link on the site.
MTRX_CONTACT_EMAIL=
# Only on a copy that is not the live site (staging): 1 keeps it out of search
# results (docs/STAGING.md). Never on the real site.
MTRX_NOINDEX=0
# Only for running on your own computer over http. Never on the real site.
MTRX_DEV=0
# How long things last.
MTRX_SESSION_HOURS=12
MTRX_KNOCK_MINUTES=5

# The apps (all optional). Each lives on a subdomain of this site's domain,
# for example https://rankup.<your domain> and https://rankup.<your domain>/api/stats.
RANKUP_URL=
CYBERLOGIX_URL=
OMNIARMOR_URL=
RANKUP_STATS_URL=
CYBERLOGIX_STATS_URL=
OMNIARMOR_STATS_URL=
MTRX_STATS_KEY=

# Health checks (optional): each app's public health address, asked once a minute.
RANKUP_HEALTH_URL=
CYBERLOGIX_HEALTH_URL=
OMNIARMOR_HEALTH_URL=
# Tell the owner when an app has been down this many minutes (default 5).
MTRX_ALERT_MINUTES=5
# Email for those alerts (optional; without it they show in the console only).
MTRX_ALERT_EMAIL=
MTRX_ALERT_FROM=
MTRX_SMTP_HOST=
MTRX_SMTP_PORT=587
MTRX_SMTP_USER=
MTRX_SMTP_PASSWORD=
