# Your secret knock: 4 or more taps from: logo mark rankup cyberlogix omniarmor
# Make up your own. Never commit the real one.
MTRX_KNOCK=
# One-time code to approve the first device (at least 16 characters).
# Change it to a new code to get back in if every device is lost.
MTRX_SETUP_TOKEN=
# Where the database lives (keep it on a disk that survives restarts).
MTRX_DB_PATH=data/horizon.db
# Set to 1 when running behind a hosting proxy (Render, Fly, etc.).
MTRX_TRUST_PROXY=0
# Optional: the site's public address, used in QR codes.
MTRX_PUBLIC_URL=
# Only for running on your own computer over http. Never on the real site.
MTRX_DEV=0
# How long things last.
MTRX_SESSION_HOURS=12
MTRX_KNOCK_MINUTES=5

# The apps (all optional).
RANKUP_URL=
CYBERLOGIX_URL=
OMNIARMOR_URL=
RANKUP_STATS_URL=
CYBERLOGIX_STATS_URL=
OMNIARMOR_STATS_URL=
MTRX_STATS_KEY=
