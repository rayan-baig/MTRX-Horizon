{
  "manifest_version": 3,
  "name": "Omnicyte",
  "version": "0.1.0",
  "description": "Your Omnicyte buddy in the browser: warns before you click a phishing link in webmail, chat or any page.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:47321/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Omnicyte" },
  "icons": { "128": "icon.png" }
}
